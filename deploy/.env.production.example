# Bu faylni loyiha ildizida .env.production sifatida saqlang.
# Barcha qiymatlarni almashtiring; haqiqiy sirlarni Gitga kiritmang.
# URI uchun POSTGRES_PASSWORD faqat tasodifiy hex belgilaridan iborat bo'lsin.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
BOOTSTRAP_PASSWORD=REPLACE_WITH_UNIQUE_LONG_PASSWORD
ADMIN_TOTP_SECRET=REPLACE_WITH_UNIQUE_BASE32_SECRET
APP_ORIGIN=https://rtm.example
