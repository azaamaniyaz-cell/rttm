NODE_ENV=development
APP_MODE=test
HOST=127.0.0.1
PORT=3000
# PostgreSQL uchun DATABASE_URL ni kiriting. Bo'sh bo'lsa test SQLite bazasi.
DATABASE_URL=
DATA_DIR=./data
TRUST_PROXY=0
SECURE_COOKIE=0
# Test uchun npm run setup:test noyob parol va TOTP sirini yaratadi.
# Qo'lda sozlashda ikkala qiymat ham majburiy; haqiqiy sirlarni Gitga yozmang.
BOOTSTRAP_PASSWORD=
ADMIN_TOTP_SECRET=
